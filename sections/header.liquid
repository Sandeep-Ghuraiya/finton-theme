<header>
  <h1 style="color: {{ section.settings.header_color }};">
    {{ section.settings.header_text }}
  </h1>
  {% if section.settings.header_image %}
    <img src="{{ section.settings.header_image | img_url: 'medium' }}" alt="Header Image"/>
  {% endif %}
</header>

{% schema %}
  {
    "name": "Header",
    "settings": [
      {
        "type": "text",
        "id": "header_text",
        "label": "Header Text",
        "default": "Welcome to our store!"
      }, {
        "type": "color",
        "id": "header_color",
        "label": "Header Color",
        "default": "#000000"
      }, {
        "type": "image_picker",
        "id": "header_image",
        "label": "Header Image"
      }
    ]
  }
{% endschema %}