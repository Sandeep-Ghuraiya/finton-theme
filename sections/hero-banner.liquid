<div class="hero-banner" style="background-color: {{ section.settings.banner_color }};">
  {% if section.settings.banner_image %}
    <img src="{{ section.settings.banner_image | img_url: 'master' }}" alt="Hero Banner Image"/>
  {% endif %}
  <h1>{{ section.settings.banner_text }}</h1>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "banner_text",
      "label": "Banner Text",
      "default": "Discover our latest collection!"
    },
    {
      "type": "color",
      "id": "banner_color",
      "label": "Banner Color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    }
  ]
}
{% endschema %}
